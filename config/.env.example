# AdGuard Home connection credentials for Homepage & the action pill proxy
# Keep this file private and never commit your real .env to GitHub!

# ==============================================================================
# AdGuard Home URL (Choose ONE depending on your hosting setup):
# ==============================================================================
# Option A: Bare-metal / Router / Dedicated server (Use LAN IP or hostname):
HOMEPAGE_VAR_ADGUARD_URL=http://192.168.1.1:80

# Option B: AdGuard is running as a Docker/Podman container on the same network:
# HOMEPAGE_VAR_ADGUARD_URL=http://adguard-home:80
# (or port :3000 if using AdGuard's default container web port)

# Option C: AdGuard is installed on the same host OS as Docker:
# HOMEPAGE_VAR_ADGUARD_URL=http://host.docker.internal:80 (or your host LAN IP)

# ⚠️ NOTE: Do NOT use http://localhost:80!
# From inside the Homepage container, "localhost" refers to Homepage itself.
# ==============================================================================

HOMEPAGE_VAR_ADGUARD_USER=admin
HOMEPAGE_VAR_ADGUARD_PASSWORD=your_secure_password_here
